NODE_ENV=development

DATABASE_URL=postgresql://crm:crm_password@localhost:5432/crm?schema=public
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=crm
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
API_SWAGGER_ENABLED=true
AUTH_COOKIE_NAME=crm_session
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
PASSWORD_MIN_LENGTH=12

WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

WORKER_CONCURRENCY=1

AI_PROVIDER=fake
AI_DEFAULT_MODEL=fake-v1
OUTREACH_GENERATION_BATCH_SIZE=25
DELIVERY_ATTEMPTS=5
DELIVERY_BACKOFF_MS=2000
INBOUND_PROVIDER=fake
RESEND_WEBHOOK_SECRET=
INBOUND_MAX_BODY_BYTES=262144
INBOUND_ATTEMPTS=5
INBOUND_BACKOFF_MS=2000
