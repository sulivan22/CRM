{
  "name": "@crm/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://crm:crm_password@localhost:5432/crm?schema=public} prisma generate",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-postgresql://crm:crm_password@localhost:5432/crm?schema=public} prisma migrate deploy",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-postgresql://crm:crm_password@localhost:5432/crm?schema=public} tsx prisma/seed.ts",
    "db:sessions:cleanup": "DATABASE_URL=${DATABASE_URL:-postgresql://crm:crm_password@localhost:5432/crm?schema=public} tsx src/cleanup-expired-sessions.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1"
  },
  "devDependencies": {
    "@crm/eslint-config": "workspace:*",
    "@crm/tsconfig": "workspace:*",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
