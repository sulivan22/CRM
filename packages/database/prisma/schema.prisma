generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model SystemHealth {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_health")
}
