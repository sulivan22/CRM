    "@nestjs/core": "^10.4.15",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@crm/eslint-config": "workspace:*",
    "@crm/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
