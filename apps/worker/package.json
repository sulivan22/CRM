{
  "name": "@crm/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "job:test": "tsx src/run-bootstrap-job.ts",
    "health": "tsx src/health.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@crm/config": "workspace:*",
    "bullmq": "^5.34.2",
    "reflect-metadata": "^0.2.2",
